# Copy to .env before running `docker compose up`.
# Values here are read by app.core.config.Settings. docker-compose.yml
# overrides DATABASE_URL / S3_ENDPOINT_URL / SQS_* for container networking
# (postgres/minio/elasticmq hostnames) -- everything else comes from here.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Bearer token -> user email, comma-separated. Demo-grade auth only --
# see backend/app/core/security.py.
DEV_API_KEYS=dev-key-alice:alice@example.com,dev-key-bob:bob@example.com

# --- Embeddings ---
# "mock" (default) is deterministic and needs no API key. Set to "openai"
# for real embeddings, and update EMBEDDING_DIMENSION to 1536 (plus run a
# fresh migration -- see README "Changing the embedding model").
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
# OPENAI_API_KEY=sk-...

# --- Generation ---
# "mock" (default) answers extractively from retrieved chunks, no API key
# needed. Set to "anthropic" for real synthesis quality.
GENERATION_PROVIDER=mock
GENERATION_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Tuning (blueprint sections 10, 12.3) ---
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=6
